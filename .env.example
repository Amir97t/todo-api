# Copy this file to .env and fill in real values. .env is gitignored.

# Runtime (NestJS + Prisma adapter) — pooled Neon URL for production,
# direct local PostgreSQL URL for local development.
DATABASE_URL="postgresql://user:password@localhost:5432/todo_dev?schema=public"

# Prisma CLI (migrations, generate) — direct PostgreSQL URL.
# For Neon: use the non-pooled direct connection string.
# For local dev: can be the same as DATABASE_URL.
DIRECT_URL="postgresql://user:password@localhost:5432/todo_dev?schema=public"

PORT=3000
# Comma-separated browser origins allowed by CORS and enforced by the CSRF
# origin check (same single allowlist for both). Must list the exact
# frontend origin(s) that call the API (e.g. https://tasknote.vercel.app);
# never use wildcards such as *.vercel.app.
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"

# --- Resource authentication mode (Checkpoint 4-1b) ---
# REQUIRE_AUTH=enforce requires a valid Bearer JWT on every resource route
# (lists, tasks, checklist). REQUIRE_AUTH=off allows anonymous access scoped
# exclusively to pre-ownership legacy rows (List.userId IS NULL); a request
# that presents a Bearer token is still fully validated — an invalid or
# expired token returns 401 and never falls back to the anonymous scope.
# Missing or invalid values fail closed to "enforce". Local development
# typically starts with "off" while the frontend has no auth UI; Production
# should set "enforce" once the frontend sends tokens.
REQUIRE_AUTH=enforce

# --- Auth rate limiting (Checkpoint 4-A) ---
# RATE_LIMIT=off keeps throttling fully disabled (local/test default).
# RATE_LIMIT_HMAC_SECRET is required whenever RATE_LIMIT=on; generate with
# `openssl rand -hex 32`. Never commit real values.
# Limits use "<count>/<window>" (e.g. 10/min, 5/hour).
# Provider defaults to "redis" (fail-closed) when RATE_LIMIT=on; set
# "memory" explicitly for local development. UPSTASH_REDIS_REST_URL /
# UPSTASH_REDIS_REST_TOKEN are required only for provider "redis"
# (Production/Preview) — provision via the Upstash console.
RATE_LIMIT=off
RATE_LIMIT_PROVIDER=memory
RATE_LIMIT_HMAC_SECRET=
RATE_LIMIT_LOGIN=10/min
RATE_LIMIT_REGISTER=5/hour
RATE_LIMIT_REFRESH=30/min
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
