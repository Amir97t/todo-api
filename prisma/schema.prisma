// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique @db.Citext
  passwordHash  String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  lists         List[]
}

model RefreshToken {
  id        String       @id @default(uuid()) @db.Uuid
  tokenHash String       @unique  // SHA-256 hex
  userId    String       @db.Uuid
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId  String?      @db.Uuid
  parent    RefreshToken? @relation("Rotation", fields: [parentId], references: [id])
  children  RefreshToken[] @relation("Rotation")
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime     @default(now())

  @@index([userId])
}

model List {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.Citext
  icon      String?
  userId    String?  @db.Uuid
  isInbox   Boolean  @default(false)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]

  // Per-user list names; `name` is CITEXT, so this is case-insensitive.
  @@unique([userId, name])

  // At most one Inbox per user. NULL userId rows are not constrained by
  // this index (PostgreSQL treats NULLs as distinct in unique indexes);
  // unowned-list name uniqueness is preserved by the legacy index below.
  @@unique([userId], map: "List_userId_inbox_key", where: { isInbox: true })

  // Legacy single-user behavior: list names stay globally unique among
  // unowned lists (userId IS NULL), matching the pre-ownership constraint.
  @@unique([name], map: "List_name_legacy_key", where: { userId: null })
}

model Task {
  id          String          @id @default(uuid()) @db.Uuid
  title       String
  description String?
  completed   Boolean         @default(false)
  listId      String          @db.Uuid
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  list        List            @relation(fields: [listId], references: [id], onDelete: Restrict)
  checklist   ChecklistItem[]

  @@index([completed])
  @@index([listId, completed, createdAt])
}

model ChecklistItem {
  id        String  @id @default(uuid()) @db.Uuid
  text      String
  completed Boolean @default(false)
  position  Int
  taskId    String  @db.Uuid
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, position])
}